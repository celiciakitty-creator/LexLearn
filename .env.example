# Ludwitt OAuth (server-side only — never expose to the browser)
LUDWITT_CLIENT_ID=
LUDWITT_CLIENT_SECRET=
LUDWITT_REDIRECT_URI=http://localhost:3000/auth/callback

# Encrypts the HttpOnly session cookie (min 32 characters)
LUDWITT_SESSION_SECRET=

# Public site URL for metadata and Open Graph (no trailing slash)
# Local: http://localhost:3000
# Production: https://your-domain.example
NEXT_PUBLIC_SITE_URL=

# Optional: external market-validation survey (2-minute survey CTA)
# When unset, survey buttons are hidden across the site
NEXT_PUBLIC_LEXLEARN_SURVEY_URL=

# Week 5 Hult/Ludwitt reference metrics API (server-side only — never NEXT_PUBLIC_*)
HULT_METRICS_API_BASE_URL=https://lexlearn-week5-metrics-api.vercel.app
HULT_METRICS_APP_ID=10af7f09-1664-4ccf-866c-c917dc9d9df2
HULT_METRICS_DEV_API_KEY=

# Optional: feedback persistence backend (not configured in Week 5 pilot)
# FEEDBACK_PERSISTENCE_BACKEND=
